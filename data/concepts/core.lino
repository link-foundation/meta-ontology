(link
  (label Link)
  (origin lino)
  (definition link is a reference to a thing or to other links)
  (definition link is a connection between concepts)
  (definition link is the basic unit of the meta_ontology)
  (mapping owl_Property)
  (mapping rdf_Property))
(reference
  (label Reference)
  (origin lino)
  (definition reference is a name that points to a link or to a concept)
  (definition reference is part of a link))
(name
  (label Name)
  (origin lino)
  (definition name is a reference used to identify a concept)
  (definition name is words attached to a concept))
(concept
  (label Concept)
  (origin lino)
  (definition concept is a thing in the ontology)
  (definition concept is a unit of meaning that can be defined by other concepts)
  (definition concept is something that can be linked to other concepts)
  (mapping skos_Concept))
(thing
  (label Thing)
  (origin lino)
  (definition thing is something or someone)
  (definition thing is the most general kind of concept)
  (definition thing can be a body or not a body)
  (mapping schema_Thing)
  (mapping owl_Thing)
  (mapping wikidata_Q35120)
  (mapping sumo_Entity))
(object
  (label Object)
  (origin lino)
  (definition object is a thing that has parts)
  (definition object is a thing that can be encoded as a link)
  (mapping sumo_Object))
(term
  (label Term)
  (origin lino)
  (definition term is a name used in the ontology)
  (definition term is a word that refers to a concept))
(class
  (label Class)
  (origin lino)
  (definition class is a kind of concept)
  (definition class is a category of things)
  (mapping owl_Class)
  (mapping rdfs_Class)
  (mapping schema_Class))
(property
  (label Property)
  (origin lino)
  (definition property is a kind of link between concepts)
  (definition property is a kind of relation)
  (mapping owl_ObjectProperty)
  (mapping rdf_Property))
(relation
  (label Relation)
  (origin lino)
  (definition relation is a link between two or more concepts)
  (definition relation is a kind of property))
(set
  (label Set)
  (origin lino)
  (definition set is a collection of things)
  (definition set is a kind of concept that contains other concepts)
  (mapping cyc_Collection))
(entity
  (label Entity)
  (origin lino)
  (definition entity is a thing that exists)
  (definition entity is the most general kind of object)
  (mapping sumo_Entity)
  (mapping wikidata_Q35120))
(definition
  (label Definition)
  (origin lino)
  (definition definition is a link that explains a concept using other concepts)
  (definition definition uses words to make a concept clear))
(category
  (label Category)
  (origin lino)
  (definition category is a kind of class)
  (definition category groups concepts that share something))
(meta_ontology
  (label (meta ontology))
  (origin lino)
  (definition meta_ontology is an ontology that defines its own concepts)
  (definition meta_ontology is a network of links between concepts)
  (definition meta_ontology contains every concept used to describe itself))
(ontology
  (label Ontology)
  (origin lino)
  (definition ontology is a set of concepts and relations between them)
  (definition ontology describes a domain of things))
(network
  (label Network)
  (origin lino)
  (definition network is a graph of concepts connected by links)
  (definition network can have cycles))
(graph
  (label Graph)
  (origin lino)
  (definition graph is a set of nodes and a set of edges between them))
(node
  (label Node)
  (origin lino)
  (definition node is a point in a graph)
  (definition node is a concept in the network))
(edge
  (label Edge)
  (origin lino)
  (definition edge is a connection between two nodes in a graph)
  (definition edge is a kind of link))
(cycle
  (label Cycle)
  (origin lino)
  (definition cycle is a path in a graph that returns to its start)
  (definition cycle shows that the graph is not a tree))
(tree
  (label Tree)
  (origin lino)
  (definition tree is a graph without cycles))
(prime
  (label Prime)
  (origin lino)
  (definition prime is a concept that cannot be defined without using itself)
  (definition prime is a basic concept used to define others)
  (definition prime is part of a meta_ontology))
(allolex
  (label Allolex)
  (origin nsm)
  (definition allolex is a different surface form of the same prime)
  (definition allolex is a synonym used by NSM))
(exponent
  (label Exponent)
  (origin nsm)
  (definition exponent is the lexical form of a prime in a language))
(language
  (label Language)
  (origin lino)
  (definition language is a system of words used by people)
  (definition language has its own exponents for the primes))
(word
  (label Word)
  (origin lino)
  (definition word is a unit of language)
  (definition word can be a name for a concept))
